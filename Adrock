<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ADRock Plant Operations & Invoicing Suite</title>

  <!-- Firebase SDKs -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

  <style>
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { margin: 0; background: #0f172a; color: #f8fafc; padding-bottom: 70px; }

    /* LOGIN OVERLAY */
    #login_overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: #090d16; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 20px;
    }
    .login-box {
      background: #1e293b; border: 2px solid #f59e0b; border-radius: 12px;
      padding: 24px; width: 100%; max-width: 360px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .login-box h2 { color: #f59e0b; margin: 0 0 16px; font-size: 22px; font-weight: 900; letter-spacing: 1.5px; }
    .login-box input, .login-box select {
      width: 100%; padding: 12px; margin-bottom: 12px; background: #0b1329; border: 1px solid #334155;
      border-radius: 6px; color: #fff; font-size: 13.5px; outline: none;
    }

    header {
      background: linear-gradient(135deg, #0b1329, #172554);
      padding: 12px 16px;
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 2px solid #f59e0b;
    }
    .brand-title { font-size: 20px; font-weight: 900; color: #f59e0b; letter-spacing: 1.5px; text-transform: uppercase; }
    .header-controls { display: flex; gap: 8px; align-items: center; }
    .lang-select { background: #0b1329; color: #f59e0b; border: 1px solid #f59e0b; padding: 5px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; outline: none; }
    .btn-logout { background: #334155; color: #cbd5e1; border: 1px solid #475569; padding: 5px 10px; border-radius: 4px; font-size: 11px; cursor: pointer; }

    /* CSS TABS */
    .tab-input { display: none; }
    .nav-bar {
      display: flex; overflow-x: auto; background: #0b1329; border-bottom: 1px solid #334155;
      position: sticky; top: 0; z-index: 1000; padding: 6px; gap: 6px;
    }
    .nav-label {
      flex: 1; min-width: 120px; padding: 10px 8px; border: 1px solid #334155; background: #1e293b;
      color: #cbd5e1; font-size: 11.5px; font-weight: bold; border-radius: 6px; cursor: pointer; text-align: center; white-space: nowrap;
    }
    #tab1:checked ~ .nav-bar label[for="tab1"],
    #tab2:checked ~ .nav-bar label[for="tab2"],
    #tab3:checked ~ .nav-bar label[for="tab3"],
    #tab4:checked ~ .nav-bar label[for="tab4"],
    #tab5:checked ~ .nav-bar label[for="tab5"],
    #tab6:checked ~ .nav-bar label[for="tab6"],
    #tab7:checked ~ .nav-bar label[for="tab7"],
    #tab8:checked ~ .nav-bar label[for="tab8"],
    #tab9:checked ~ .nav-bar label[for="tab9"],
    #tab10:checked ~ .nav-bar label[for="tab10"],
    #tab11:checked ~ .nav-bar label[for="tab11"],
    #tab12:checked ~ .nav-bar label[for="tab12"] {
      background: #f59e0b; color: #0b1329; border-color: #f59e0b;
    }

    .container { max-width: 1180px; margin: 15px auto; padding: 0 12px; }
    .page-section { display: none; }
    #tab1:checked ~ .container #p_dash { display: block; }
    #tab2:checked ~ .container #p_units { display: block; }
    #tab3:checked ~ .container #p_fixed { display: block; }
    #tab4:checked ~ .container #p_bill_gen { display: block; }
    #tab5:checked ~ .container #p_att { display: block; }
    #tab6:checked ~ .container #p_adv { display: block; }
    #tab7:checked ~ .container #p_voucher { display: block; }
    #tab8:checked ~ .container #p_payroll { display: block; }
    #tab9:checked ~ .container #p_company_flow { display: block; }
    #tab10:checked ~ .container #p_fpower { display: block; }
    #tab11:checked ~ .container #p_store { display: block; }
    #tab12:checked ~ .container #p_masters { display: block; }

    .box { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 16px; margin-bottom: 16px; }
    .box h2 { margin: 0 0 14px; font-size: 14.5px; color: #f59e0b; border-bottom: 1px solid #334155; padding-bottom: 8px; text-transform: uppercase; }

    .grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .card { background: #131f3f; border: 1px solid #1e293b; border-radius: 8px; padding: 12px; }
    .card h3 { margin: 0 0 4px; font-size: 11px; color: #94a3b8; text-transform: uppercase; }
    .card .val { font-size: 19px; font-weight: bold; color: #f59e0b; }

    .filter-box { background: #0b1329; padding: 10px 12px; border-radius: 8px; border: 1px solid #334155; margin-bottom: 12px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .filter-box label { font-size: 11.5px; font-weight: bold; color: #f59e0b; text-transform: uppercase; }

    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 12px; }
    .form-group { display: flex; flex-direction: column; }
    .form-group label { font-size: 11px; font-weight: 600; margin-bottom: 4px; color: #cbd5e1; text-transform: uppercase; }
    .form-group input, .form-group select { padding: 9px; background: #0b1329; border: 1px solid #334155; border-radius: 6px; color: #fff; font-size: 12.5px; outline: none; }

    .btn { background: #f59e0b; color: #0b1329; border: none; padding: 11px 16px; border-radius: 6px; font-weight: 800; cursor: pointer; font-size: 12.5px; text-transform: uppercase; width: 100%; }
    .btn-del { background: #ef4444; color: #fff; border: none; padding: 5px 8px; border-radius: 4px; cursor: pointer; font-size: 11px; }
    .btn-clear { background: #334155; color: #fff; border: none; padding: 6px 10px; border-radius: 4px; font-size: 11px; cursor: pointer; }
    .btn-sec { background: #38bdf8; color: #0b1329; border: none; padding: 8px 12px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12px; }

    .table-wrap { width: 100%; overflow-x: auto; margin-top: 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th, td { padding: 8px 10px; border: 1px solid #334155; text-align: left; }
    th { background: #0b1329; color: #94a3b8; text-transform: uppercase; font-size: 11px; }
    .num { text-align: right; }
    .comp-tag { color: #38bdf8; font-weight: 600; }

    .comp-section-header {
      background: #131f3f; padding: 10px 14px; font-size: 13.5px; font-weight: 800;
      color: #38bdf8; border-radius: 6px; margin-top: 15px; margin-bottom: 8px;
      border-left: 4px solid #38bdf8; display: flex; justify-content: space-between;
    }

    /* PRINTABLE INVOICE / QUOTATION STYLES */
    @media print {
      body * { visibility: hidden !important; }
      #printable_invoice_area, #printable_invoice_area * { visibility: visible !important; }
      #printable_invoice_area {
        position: absolute; left: 0; top: 0; width: 100%; background: #ffffff !important;
        color: #000000 !important; padding: 25px; margin: 0; font-size: 13px;
      }
      #printable_invoice_area table, #printable_invoice_area th, #printable_invoice_area td {
        border: 1px solid #334155 !important; color: #000000 !important;
      }
      #printable_invoice_area th { background: #f1f5f9 !important; }
      .no-print { display: none !important; }
    }

    .inv-sheet {
      background: #ffffff; color: #0f172a; border-radius: 8px; padding: 25px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3); margin-top: 15px; border: 1px solid #cbd5e1;
    }
    .inv-sheet table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 12.5px; }
    .inv-sheet th, .inv-sheet td { border: 1px solid #94a3b8; padding: 8px 10px; color: #0f172a; }
    .inv-sheet th { background: #f8fafc; font-weight: 800; color: #1e293b; }
    .inv-header { display: flex; justify-content: space-between; border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 15px; }
  </style>
</head>
<body>

  <!-- LOGIN OVERLAY -->
  <div id="login_overlay">
    <div class="login-box">
      <h2>⚡ ADROCK LOGIN</h2>
      <p style="font-size:12px; color:#94a3b8; margin-bottom:14px;">Select Account Type to Access</p>
      
      <select id="log_role" onchange="toggleLoginCompField()">
        <option value="admin">👑 Main Admin (All Access)</option>
        <option value="client">🏢 Client Portal (Company Login)</option>
      </select>

      <div id="log_comp_wrap" style="display:none;">
        <label style="font-size:11px; color:#94a3b8; display:block; text-align:left; margin-bottom:4px;">SELECT COMPANY:</label>
        <select id="log_comp"></select>
      </div>

      <input type="text" id="log_user" placeholder="User ID">
      <input type="password" id="log_pass" placeholder="Password">
      <button type="button" class="btn" onclick="checkAuth()">Login</button>
      <div id="log_err" style="color:#ef4444; font-size:11.5px; margin-top:10px; display:none;">Invalid Credentials or Company Match!</div>
    </div>
  </div>

  <!-- RADIO TABS (1 to 12) -->
  <input type="radio" name="tabs" id="tab1" class="tab-input" checked>
  <input type="radio" name="tabs" id="tab2" class="tab-input">
  <input type="radio" name="tabs" id="tab3" class="tab-input">
  <input type="radio" name="tabs" id="tab4" class="tab-input">
  <input type="radio" name="tabs" id="tab5" class="tab-input">
  <input type="radio" name="tabs" id="tab6" class="tab-input">
  <input type="radio" name="tabs" id="tab7" class="tab-input">
  <input type="radio" name="tabs" id="tab8" class="tab-input">
  <input type="radio" name="tabs" id="tab9" class="tab-input">
  <input type="radio" name="tabs" id="tab10" class="tab-input">
  <input type="radio" name="tabs" id="tab11" class="tab-input">
  <input type="radio" name="tabs" id="tab12" class="tab-input">

  <header>
    <div>
      <div class="brand-title">⚡ ADROCK</div>
      <div id="role_status_badge" style="font-size:10px; color:#10b981;">🟢 Live Cloud Sync</div>
    </div>
    <div class="header-controls">
      <select id="global_lang_select" class="lang-select" onchange="changeLanguage(this.value)">
        <option value="en">English</option>
        <option value="ml">മലയാളം</option>
        <option value="hi">हिन्दी</option>
      </select>
      <button type="button" class="btn-logout" onclick="logout()" id="lbl_logout">Lock App</button>
    </div>
  </header>

  <!-- NAVIGATION TABS -->
  <div class="nav-bar">
    <label for="tab1" id="nav_dash" class="nav-label" onclick="refreshStats()">Dashboard</label>
    <label for="tab2" id="nav_units" class="nav-label">Units Entry</label>
    <label for="tab3" id="nav_fixed" class="nav-label">Fixed Billing</label>
    <label for="tab4" id="nav_bill_gen" class="nav-label" style="border-color:#38bdf8; color:#38bdf8;">🧾 Invoice & Quotation</label>
    <label for="tab5" id="nav_att" class="nav-label">📋 Daily Sheet</label>
    <label for="tab6" id="nav_adv" class="nav-label">📒 Advance Ledger</label>
    <label for="tab7" id="nav_voucher" class="nav-label">📑 Staff Voucher</label>
    <label for="tab8" id="nav_payroll" class="nav-label">💰 Salary Payout</label>
    <label for="tab9" id="nav_company_flow" class="nav-label">🏢 Company Ledger</label>
    <label for="tab10" id="nav_fpower" class="nav-label" style="border-color:#f59e0b; color:#f59e0b;">⚡ F-Power</label>
    <label for="tab11" id="nav_store" class="nav-label">📦 Store / Stock</label>
    <label for="tab12" id="nav_masters" class="nav-label">⚙️ Masters & Users</label>
  </div>

  <div class="container">

    <!-- 1. DASHBOARD -->
    <div id="p_dash" class="page-section">
      <div class="filter-box">
        <label id="lbl_dash_month">Filter Month:</label>
        <input type="month" id="dash_filter_month" onchange="refreshStats()">
        <button type="button" class="btn-clear" onclick="clearDashFilter()" id="lbl_all_time">All Time</button>
      </div>

      <div class="grid-cards">
        <div class="card" style="border: 2px solid #10b981; background: #0c2e26;">
          <h3 style="color:#34d399; font-weight:bold;" id="c_net_balance">💵 Net In-Hand Balance</h3>
          <div class="val" style="color: #34d399; font-size: 22px;" id="d_net_balance">₹0.00</div>
        </div>
        <div class="card">
          <h3 id="c_tot_units">Total Units Produced</h3>
          <div class="val" id="d_units">0.00</div>
        </div>
        <div class="card" style="border: 1px solid #10b981;">
          <h3 style="color:#10b981;" id="c_cur_units">This Month Units</h3>
          <div class="val" style="color: #10b981;" id="d_cur_month_units">0.00</div>
        </div>
        <div class="card">
          <h3 id="c_gross_billed">Gross Billing (Without TDS)</h3>
          <div class="val" style="color: #f59e0b;" id="d_billed_gross">₹0.00</div>
        </div>
        <div class="card">
          <h3 id="c_tds_cut">Total TDS Deducted</h3>
          <div class="val" style="color: #cbd5e1;" id="d_billed_tds">₹0.00</div>
        </div>
        <div class="card">
          <h3 id="c_net_billed">Net Billing (With TDS)</h3>
          <div class="val" style="color: #38bdf8;" id="d_billed_net">₹0.00</div>
        </div>
        <div class="card">
          <h3 id="c_rec">Client Receipts (Inflow)</h3>
          <div class="val" style="color: #10b981;" id="d_received">₹0.00</div>
        </div>
        <div class="card">
          <h3 id="c_due">Pending Due</h3>
          <div class="val" style="color: #ef4444;" id="d_pending">₹0.00</div>
        </div>
      </div>

      <div class="box">
        <h2 id="t_month_summary">📊 Month-Wise Billing & TDS Summary</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th id="th_m_month">Month</th>
                <th class="num" style="color:#f59e0b;" id="th_m_units">Units Produced</th>
                <th class="num" style="color:#f59e0b;" id="th_m_gross">Total Gross (₹)</th>
                <th class="num" style="color:#cbd5e1;" id="th_m_tds">TDS Deducted (₹)</th>
                <th class="num" style="color:#10b981; font-weight:bold;" id="th_m_net">Total Net (₹)</th>
              </tr>
            </thead>
            <tbody id="dash_monthly_units_rows"></tbody>
          </table>
        </div>
      </div>

      <div class="box">
        <h2 id="t_comp_summary">Company Billing Summary (With & Without TDS)</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Company</th>
                <th>Model</th>
                <th class="num" style="color:#f59e0b;">Gross (₹)</th>
                <th class="num" style="color:#cbd5e1;">TDS (₹)</th>
                <th class="num" style="color:#38bdf8;">Net (₹)</th>
                <th class="num" style="color:#10b981;">Received (₹)</th>
                <th class="num" style="color:#ef4444;">Pending Due (₹)</th>
              </tr>
            </thead>
            <tbody id="dash_companies_rows"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 2. UNITS ENTRY / BILLING -->
    <div id="p_units" class="page-section">
      <div class="box">
        <h2 id="t_unit_entry">Record Daily Production Units</h2>
        <div class="form-grid">
          <div class="form-group"><label id="lbl_u_date">Date</label><input type="date" id="u_date"></div>
          <div class="form-group"><label id="lbl_u_comp">Company / Plant</label><select id="u_comp"></select></div>
          <div class="form-group"><label id="lbl_u_qty">Units Produced</label><input type="number" id="u_val" placeholder="e.g. 150" oninput="runUnitMath()"></div>
          
          <div class="form-group admin-only-field"><label id="lbl_u_rate">Rate / Unit (₹)</label><input type="number" id="u_rate" value="60" oninput="runUnitMath()"></div>
          
          <div class="form-group admin-only-field">
            <label>GST Applied</label>
            <select id="u_gst_pct" onchange="runUnitMath()">
              <option value="0">0% (Non-GST / Exempted)</option>
              <option value="5">5% GST</option>
              <option value="12">12% GST</option>
              <option value="18">18% GST</option>
            </select>
          </div>
          
          <div class="form-group admin-only-field"><label id="lbl_u_gross">Gross Amount (Without TDS)</label><input type="text" id="u_gross" readonly style="background:#0b1329; color:#f59e0b; font-weight:bold;"></div>
          <div class="form-group admin-only-field"><label id="lbl_u_net">Net Payable (1% TDS Cut)</label><input type="text" id="u_net" readonly style="background:#0b1329; color:#38bdf8; font-weight:bold;"></div>
          
          <div class="form-group" style="grid-column: 1 / -1;"><label id="lbl_u_notes">Comments / Shift Remarks</label><input type="text" id="u_notes" placeholder="Shift or remarks"></div>
        </div>
        <button type="button" class="btn" onclick="saveUnit()" id="btn_save_unit">Save Daily Unit Entry</button>
      </div>

      <div class="box admin-only-field" id="units_history_box">
        <h2 id="t_unit_hist">Units History (Chronological Order)</h2>
        <div class="filter-box">
          <label>Filter Month:</label>
          <input type="month" id="u_filter_month" onchange="renderUnitsTable()">
          <button type="button" class="btn-clear" onclick="document.getElementById('u_filter_month').value=''; renderUnitsTable();">Show All</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Company</th><th class="num">Units</th><th class="num" style="color:#f59e0b;">Gross (₹)</th><th class="num" style="color:#38bdf8;">Net (₹)</th><th>Notes</th><th>Action</th></tr></thead>
            <tbody id="units_rows"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 3. FIXED BILLING -->
    <div id="p_fixed" class="page-section">
      <div class="box">
        <h2>Record Fixed Monthly Billing</h2>
        <div class="form-grid">
          <div class="form-group"><label>Date</label><input type="date" id="f_date"></div>
          <div class="form-group"><label>Company / Plant</label><select id="f_comp"></select></div>
          <div class="form-group"><label>Gross Amount (Without TDS ₹)</label><input type="number" id="f_gross" oninput="runFixedMath()"></div>
          <div class="form-group"><label>TDS %</label><input type="number" id="f_tds_pct" value="1" oninput="runFixedMath()"></div>
          <div class="form-group"><label>Net Amount (With TDS ₹)</label><input type="text" id="f_net" readonly style="background:#0b1329; color:#38bdf8; font-weight:bold;"></div>
          <div class="form-group" style="grid-column: 1 / -1;"><label>Description</label><input type="text" id="f_notes" placeholder="Monthly Retainer Details"></div>
        </div>
        <button type="button" class="btn" onclick="saveFixed()">Save Fixed Entry</button>
      </div>

      <div class="box">
        <h2>Fixed Billing History</h2>
        <div class="filter-box">
          <label>Filter Month:</label>
          <input type="month" id="f_filter_month" onchange="renderFixedTable()">
          <button type="button" class="btn-clear" onclick="document.getElementById('f_filter_month').value=''; renderFixedTable();">Show All</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Company</th><th class="num" style="color:#f59e0b;">Gross (₹)</th><th class="num" style="color:#38bdf8;">Net (₹)</th><th>Notes</th><th>Action</th></tr></thead>
            <tbody id="fixed_rows"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 4. 🧾 INVOICE & QUOTATION BUILDER (ACTIVE TAB) -->
    <div id="p_bill_gen" class="page-section">
      <div class="box no-print" style="border:1px solid #38bdf8;">
        <h2 style="color:#38bdf8;">🧾 Premium Tax Invoice & Quotation Generator</h2>
        <p style="font-size:11.5px; color:#94a3b8; margin-top:-6px;">
          ഇൻവോയ്സ് (Invoice) അല്ലെങ്കിൽ കൊട്ടേഷൻ (Quotation) തയ്യാറാക്കാം. വിവരങ്ങൾ നൽകി താഴെയുള്ള ബട്ടൺ ക്ലിക്ക് ചെയ്ത് പ്രിന്റ് എടുക്കുകയോ PDF ആയി സേവ് ചെയ്യുകയോ ചെയ്യാം.
        </p>

        <div class="form-grid">
          <div class="form-group">
            <label>Document Type</label>
            <select id="gen_doc_type" onchange="refreshInvoiceTemplate()">
              <option value="TAX INVOICE">TAX INVOICE (ടാക്സ് ഇൻവോയ്സ്)</option>
              <option value="QUOTATION">QUOTATION (കൊട്ടേഷൻ / എസ്റ്റിമേറ്റ്)</option>
              <option value="PROFORMA INVOICE">PROFORMA INVOICE (പ്രൊഫോർമ)</option>
            </select>
          </div>
          <div class="form-group"><label>Doc / Ref No</label><input type="text" id="gen_inv_no" value="ADR/2026/001" oninput="refreshInvoiceTemplate()"></div>
          <div class="form-group"><label>Issue Date</label><input type="date" id="gen_inv_date" onchange="refreshInvoiceTemplate()"></div>
