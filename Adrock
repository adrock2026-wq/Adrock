    function renderPartnersSummaryTable() {
      var tbody = document.getElementById('partners_summary_rows');
      if (!tbody) return;
      tbody.innerHTML = '';

      var companyNetProfits = {};
      for (var ck in companies) {
        var cName = companies[ck].name;
        var compBilledNet = 0;
        for (var uk in unitsList) {
          if (unitsList[uk].comp === cName) compBilledNet += Number(unitsList[uk].net || 0);
        }
        for (var fk in fixedList) {
          if (fixedList[fk].comp === cName) compBilledNet += Number(fixedList[fk].net || 0);
        }

        var compExp = 0;
        for (var ek in expList) {
          if (expList[ek].comp === cName) compExp += Number(expList[ek].amt || 0);
        }

        var compSalary = 0;
        for (var pk in payrollList) {
          if (payrollList[pk].comp === cName) compSalary += Number(payrollList[pk].net || 0);
        }

        var netProfit = compBilledNet - (compExp + compSalary);
        companyNetProfits[cName] = netProfit > 0 ? netProfit : 0;
      }

      var summary = {};
      for (var pk in partnersList) {
        var part = partnersList[pk];
        var pKey = part.name + '_' + (part.comp || 'General');
        var compProfit = companyNetProfits[part.comp] || 0;
        var autoShareAmt = (compProfit * (Number(part.share || 0) / 100));

        summary[pKey] = {
          _key: pk, name: part.name, comp: part.comp || 'General', share: part.share || 0,
          compProfit: compProfit, autoShareAmt: autoShareAmt, transOut: 0
        };
      }

      for (var fk in fpowerList) {
        var tx = fpowerList[fk];
        var pSelectVal = tx.partner;
        for (var key in summary) {
          var expectedTag = summary[key].name + ' (' + summary[key].comp + ')';
          if (pSelectVal === expectedTag || pSelectVal === summary[key].name) {
            if (tx.type === 'TRANSFER_OUT') summary[key].transOut += Number(tx.amt || 0);
          }
        }
      }

      var hasPartners = false;
      var totalAutoShareSum = 0;
      for (var k in summary) {
        hasPartners = true;
        var p = summary[k];
        var duePayable = p.autoShareAmt - p.transOut;
        totalAutoShareSum += p.autoShareAmt;

        tbody.innerHTML += '<tr>' +
          '<td><strong>' + p.name + '</strong></td>' +
          '<td><span class="comp-tag">' + p.comp + '</span></td>' +
          '<td class="num" style="color:#f59e0b; font-weight:bold; font-size:13px;">' + p.share + '%</td>' +
          '<td class="num" style="color:#38bdf8;">₹' + p.compProfit.toLocaleString('en-IN', {minimumFractionDigits:2}) + '</td>' +
          '<td class="num" style="color:#10b981; font-weight:bold;">₹' + p.autoShareAmt.toLocaleString('en-IN', {minimumFractionDigits:2}) + '</td>' +
          '<td class="num" style="color:#f87171;">₹' + p.transOut.toLocaleString('en-IN', {minimumFractionDigits:2}) + '</td>' +
          '<td class="num" style="color:#38bdf8; font-weight:bold; font-size:13px;">₹' + duePayable.toLocaleString('en-IN', {minimumFractionDigits:2}) + '</td>' +
          '<td><button class="btn-del" onclick="delPartner(\'' + p._key + '\')">Delete</button></td>' +
        '</tr>';
      }

      document.getElementById('fp_stat_net').innerText = '₹' + totalAutoShareSum.toLocaleString('en-IN', {minimumFractionDigits:2});

      if (!hasPartners) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:#94a3b8; padding:14px;">No partners registered yet. Add partners above.</td></tr>';
      }
    }

    function delPartner(key) {
      if (confirm('Delete this partner profile?')) db.ref('partners/' + key).remove();
    }

    function saveFPowerEntry() {
      var d = document.getElementById('fp_date').value;
      var partner = document.getElementById('fp_partner_select').value || 'Owner General';
      var type = document.getElementById('fp_type').value;
      var amt = parseFloat(document.getElementById('fp_amt').value) || 0;
      var mode = document.getElementById('fp_mode').value;
      var desc = document.getElementById('fp_desc').value.trim() || '-';

      if (!d || amt <= 0) { alert('Please enter valid Date and Amount for transaction!'); return; }

      db.ref('fpower').push({ date: d, partner: partner, type: type, amt: amt, mode: mode, desc: desc });
      document.getElementById('fp_amt').value = '';
      document.getElementById('fp_desc').value = '';
      alert('Transaction Saved Successfully!');
    }

    function renderFPowerTables() {
      var tbody = document.getElementById('fpower_rows');
      if (!tbody) return;
      tbody.innerHTML = '';

      var arr = [];
      for (var k in fpowerList) {
        var obj = fpowerList[k];
        obj._key = k;
        arr.push(obj);
      }

      sortArrayByDate(arr, 'date');

      var totalIn = 0;
      var totalOut = 0;

      for (var i = 0; i < arr.length; i++) {
        var item = arr[i];
        var isFundIn = (item.type === 'FUND_IN');
        var inVal = isFundIn ? Number(item.amt || 0) : 0;
        var outVal = !isFundIn ? Number(item.amt || 0) : 0;

        totalIn += inVal;
        totalOut += outVal;

        var typeBadge = isFundIn ? '<span style="color:#34d399; font-weight:bold;">🟢 Capital In</span>' :
                        (item.type === 'TRANSFER_OUT' ? '<span style="color:#f87171; font-weight:bold;">🔴 Profit Transfer</span>' :
                        '<span style="color:#fbbf24; font-weight:bold;">🟠 Direct Partner Expense</span>');

        tbody.innerHTML += '<tr>' +
          '<td>' + (i + 1) + '</td>' +
          '<td>' + item.date + '</td>' +
          '<td><strong style="color:#38bdf8;">' + (item.partner || 'Owner General') + '</strong></td>' +
          '<td>' + typeBadge + '</td>' +
          '<td>' + (item.mode || 'Bank Transfer') + '</td>' +
          '<td class="num" style="color:#34d399; font-weight:bold;">' + (inVal > 0 ? '₹' + inVal.toFixed(2) : '-') + '</td>' +
          '<td class="num" style="color:#f87171; font-weight:bold;">' + (outVal > 0 ? '₹' + outVal.toFixed(2) : '-') + '</td>' +
          '<td>' + item.desc + '</td>' +
          '<td><button class="btn-del" onclick="delFPower(\'' + item._key + '\')">X</button></td>' +
        '</tr>';
      }

      document.getElementById('fp_stat_in').innerText = '₹' + totalIn.toLocaleString('en-IN', {minimumFractionDigits:2});
      document.getElementById('fp_stat_out').innerText = '₹' + totalOut.toLocaleString('en-IN', {minimumFractionDigits:2});

      if (arr.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; color:#94a3b8; padding:16px;">No transactions recorded yet.</td></tr>';
      }
    }

    function delFPower(key) {
      if (confirm('Delete this transaction?')) db.ref('fpower/' + key).remove();
    }

    // UNITS MATH
    function runUnitMath() {
      var u = parseFloat(document.getElementById('u_val').value) || 0;
      var r = parseFloat(document.getElementById('u_rate').value) || 0;
      var gstPct = parseFloat(document.getElementById('u_gst_pct').value) || 0;

      var baseValue = u * r;
      var gstAmount = baseValue * (gstPct / 100);
      var gross = baseValue + gstAmount;
      var net = gross - (baseValue * 0.01);

      document.getElementById('u_gross').value = gross.toFixed(2);
      document.getElementById('u_net').value = net.toFixed(2);
    }

    function saveUnit() {
      var d = document.getElementById('u_date').value;
      var c = (currentUserRole === 'client' && currentUserComp) ? currentUserComp : document.getElementById('u_comp').value;
      var u = parseFloat(document.getElementById('u_val').value) || 0;
      var r = parseFloat(document.getElementById('u_rate').value) || 60;
      var gstPct = parseFloat(document.getElementById('u_gst_pct').value) || 0;
      var notes = document.getElementById('u_notes').value || '-';

      if (!d || u <= 0) { alert('Enter valid date & units'); return; }

      var baseValue = u * r;
      var gstAmount = baseValue * (gstPct / 100);
      var gross = baseValue + gstAmount;
      var net = gross - (baseValue * 0.01);

      db.ref('units').push({
        date: d, comp: c, units: u, rate: r, gstPct: gstPct,
        gstAmt: gstAmount, gross: gross, net: net, notes: notes
      });

      document.getElementById('u_notes').value = '';
      document.getElementById('u_val').value = '';
      alert('Units Saved Successfully!');
    }

    function renderUnitsTable() {
      var tbody = document.getElementById('units_rows');
      if (!tbody) return;
      tbody.innerHTML = '';
      var fMonth = document.getElementById('u_filter_month').value;

      var arr = [];
      for (var k in unitsList) {
        var obj = unitsList[k];
        obj._key = k;
        if (currentUserRole === 'client' && currentUserComp && obj.comp !== currentUserComp) continue;
        if (!fMonth || (obj.date && obj.date.indexOf(fMonth) === 0)) arr.push(obj);
      }
      sortArrayByDate(arr, 'date');

      for (var i = 0; i < arr.length; i++) {
        var x = arr[i];
        var grossVal = x.gross ? Number(x.gross) : (Number(x.units || 0) * (Number(x.rate) || 60));
        tbody.innerHTML += '<tr><td>' + x.date + '</td><td class="comp-tag">' + x.comp + '</td><td class="num">' + x.units + '</td><td class="num" style="color:#f59e0b;">' + grossVal.toFixed(2) + '</td><td class="num" style="color:#38bdf8; font-weight:bold;">' + Number(x.net).toFixed(2) + '</td><td>' + x.notes + '</td><td><button class="btn-del" onclick="delUnit(\'' + x._key + '\')">X</button></td></tr>';
      }
    }

    function delUnit(key) {
      if (confirm('Delete entry?')) db.ref('units/' + key).remove();
    }

    // FIXED BILLING
    function runFixedMath() {
      var g = parseFloat(document.getElementById('f_gross').value) || 0;
      var p = parseFloat(document.getElementById('f_tds_pct').value) || 0;
      var net = g - (g * (p / 100));
      document.getElementById('f_net').value = net.toFixed(2);
    }

    function saveFixed() {
      var d = document.getElementById('f_date').value;
      var c = document.getElementById('f_comp').value;
      var g = parseFloat(document.getElementById('f_gross').value) || 0;
      var p = parseFloat(document.getElementById('f_tds_pct').value) || 0;
      var notes = document.getElementById('f_notes').value || '-';

      if (!d || g <= 0) { alert('Enter valid date & amount'); return; }

      var net = g - (g * (p / 100));
      db.ref('fixed').push({ date: d, comp: c, gross: g, tdsPct: p, net: net, notes: notes });
      document.getElementById('f_notes').value = '';
      alert('Fixed Entry Saved!');
    }

    function renderFixedTable() {
      var tbody = document.getElementById('fixed_rows');
      tbody.innerHTML = '';
      var fMonth = document.getElementById('f_filter_month').value;

      var arr = [];
      for (var k in fixedList) {
        var obj = fixedList[k];
        obj._key = k;
        if (!fMonth || (obj.date && obj.date.indexOf(fMonth) === 0)) arr.push(obj);
      }
      sortArrayByDate(arr, 'date');

      for (var i = 0; i < arr.length; i++) {
        var x = arr[i];
        tbody.innerHTML += '<tr><td>' + x.date + '</td><td class="comp-tag">' + x.comp + '</td><td class="num" style="color:#f59e0b;">' + Number(x.gross).toFixed(2) + '</td><td class="num" style="color:#38bdf8; font-weight:bold;">' + Number(x.net).toFixed(2) + '</td><td>' + x.notes + '</td><td><button class="btn-del" onclick="delFixed(\'' + x._key + '\')">X</button></td></tr>';
      }
    }

    function delFixed(key) {
      if (confirm('Delete entry?')) db.ref('fixed/' + key).remove();
    }

    // STORE
    function saveStoreItem() {
      var d = document.getElementById('st_date').value;
      var comp = (currentUserRole === 'client' && currentUserComp) ? currentUserComp : document.getElementById('st_comp').value;
      var type = document.getElementById('st_type').value;
      var item = document.getElementById('st_item').value.trim();
      var qty = parseFloat(document.getElementById('st_qty').value) || 0;
      var unit = document.getElementById('st_unit').value;
      var cost = parseFloat(document.getElementById('st_cost').value) || 0;
      var notes = document.getElementById('st_notes').value || '-';

      if (!d || !comp || !item || qty <= 0) { alert('Enter date, company, item and quantity'); return; }

      db.ref('store').push({ date: d, comp: comp, type: type, item: item, qty: qty, unit: unit, cost: cost, notes: notes });
      document.getElementById('st_item').value = '';
      document.getElementById('st_qty').value = '';
      document.getElementById('st_cost').value = '';
      document.getElementById('st_notes').value = '';
      alert('Stock Movement Saved!');
    }

    function renderStoreTables() {
      var tbodyLog = document.getElementById('store_log_rows');
      var tbodyInv = document.getElementById('inventory_rows');
      if (!tbodyLog || !tbodyInv) return;
      tbodyLog.innerHTML = '';
      tbodyInv.innerHTML = '';

      var inventory = {};
      var arr = [];
      for (var k in storeList) {
        var obj = storeList[k];
        obj._key = k;
        if (currentUserRole === 'client' && currentUserComp && obj.comp !== currentUserComp) continue;
        arr.push(obj);
      }
      sortArrayByDate(arr, 'date');

      for (var i = 0; i < arr.length; i++) {
        var s = arr[i];
        var itemKey = (s.comp || 'General') + '_' + s.item.toLowerCase();
        if (!inventory[itemKey]) {
          inventory[itemKey] = { comp: s.comp || '-', name: s.item, inQty: 0, outQty: 0, unit: s.unit };
        }
        if (s.type === 'IN') inventory[itemKey].inQty += Number(s.qty);
        else inventory[itemKey].outQty += Number(s.qty);

        tbodyLog.innerHTML += '<tr><td>' + s.date + '</td><td class="comp-tag">' + (s.comp || '-') + '</td><td style="color:' + (s.type === 'IN' ? '#10b981' : '#ef4444') + '; font-weight:bold;">' + s.type + '</td><td><strong>' + s.item + '</strong></td><td class="num">' + s.qty + ' ' + s.unit + '</td><td class="num">' + (s.cost ? '₹' + s.cost : '-') + '</td><td>' + s.notes + '</td><td><button class="btn-del" onclick="delStore(\'' + s._key + '\')">X</button></td></tr>';
      }

      for (var key in inventory) {
        var item = inventory[key];
        var bal = item.inQty - item.outQty;
        tbodyInv.innerHTML += '<tr><td class="comp-tag">' + item.comp + '</td><td><strong>' + item.name + '</strong></td><td class="num">' + item.inQty + '</td><td class="num">' + item.outQty + '</td><td class="num" style="color:#f59e0b; font-weight:bold; font-size:13.5px;">' + bal + '</td><td>' + item.unit + '</td></tr>';
      }
    }

    function delStore(key) {
      if (confirm('Delete item entry?')) db.ref('store/' + key).remove();
    }

    // COMPANIES
    function addCompany() {
      var name = document.getElementById('new_c_name').value.trim();
      var type = document.getElementById('new_c_type').value;
      if (!name) { alert('Enter company name'); return; }

      db.ref('companies').push({ name: name, type: type });
      document.getElementById('new_c_name').value = '';
      alert('Company Added!');
    }

    function renderCompanyTable() {
      var tbody = document.getElementById('company_rows');
      tbody.innerHTML = '';
      var idx = 1;
      for (var k in companies) {
        tbody.innerHTML += '<tr><td>' + idx + '</td><td><strong>' + companies[k].name + '</strong></td><td>' + companies[k].type + '</td><td><button class="btn-del" onclick="delCompany(\'' + k + '\')">Delete</button></td></tr>';
        idx++;
      }
    }

    function delCompany(key) {
      if (confirm('Delete company?')) db.ref('companies/' + key).remove();
    }

    // DASHBOARD STATS REFRESH
    function clearDashFilter() {
      document.getElementById('dash_filter_month').value = '';
      refreshStats();
    }

    function refreshStats() {
      var dMonth = document.getElementById('dash_filter_month').value;
      var curCalendarMonth = new Date().toISOString().substring(0, 7);

      var totU = 0, curMonthU = 0;
      var totGrossBilled = 0, totNetBilled = 0;
      var monthlySummaryMap = {};

      for (var k in unitsList) {
        var u = unitsList[k];
        var mKey = (u.date && u.date.length >= 7) ? u.date.substring(0, 7) : 'Unknown';
        var uGross = u.gross ? Number(u.gross) : (Number(u.units || 0) * (Number(u.rate) || 60));
        var uNet = Number(u.net || 0);

        if (mKey === curCalendarMonth) curMonthU += Number(u.units || 0);

        if (!dMonth || mKey === dMonth) {
          totU += Number(u.units || 0);
          totGrossBilled += uGross;
          totNetBilled += uNet;
        }

        if (!monthlySummaryMap[mKey]) monthlySummaryMap[mKey] = { units: 0, gross: 0, net: 0 };
        monthlySummaryMap[mKey].units += Number(u.units || 0);
        monthlySummaryMap[mKey].gross += uGross;
        monthlySummaryMap[mKey].net += uNet;
      }

      for (var j in fixedList) {
        var f = fixedList[j];
        var fMonthKey = (f.date && f.date.length >= 7) ? f.date.substring(0, 7) : 'Unknown';
        var fGross = Number(f.gross || 0);
        var fNet = Number(f.net || 0);

        if (!dMonth || fMonthKey === dMonth) {
          totGrossBilled += fGross;
          totNetBilled += fNet;
        }

        if (!monthlySummaryMap[fMonthKey]) monthlySummaryMap[fMonthKey] = { units: 0, gross: 0, net: 0 };
        monthlySummaryMap[fMonthKey].gross += fGross;
        monthlySummaryMap[fMonthKey].net += fNet;
      }

      var totTdsCut = totGrossBilled - totNetBilled;

      var totRec = 0;
      for (var m in clientReceipts) {
        var r = clientReceipts[m];
        if (!dMonth || (r.date && r.date.indexOf(dMonth) === 0)) totRec += Number(r.amt || 0);
      }

      var totExpenses = 0;
      for (var eKey in expList) {
        var expObj = expList[eKey];
        if (!dMonth || (expObj.date && expObj.date.indexOf(dMonth) === 0)) totExpenses += Number(expObj.amt || 0);
      }

      var totPayrollPaid = 0;
      for (var pKey in payrollList) {
        var payObj = payrollList[pKey];
        if (!dMonth || (payObj.month && payObj.month.indexOf(dMonth) === 0)) totPayrollPaid += Number(payObj.net || 0);
      }

      var totAdvances = 0;
      for (var aKey in advanceList) {
        var advObj = advanceList[aKey];
        if (!dMonth || (advObj.date && advObj.date.indexOf(dMonth) === 0)) totAdvances += Number(advObj.amt || 0);
      }

      var liveNetBalance = totRec - (totExpenses + totPayrollPaid + totAdvances);
      var pendingDue = totNetBilled - totRec;

      document.getElementById('d_net_balance').innerText = '₹' + liveNetBalance.toLocaleString('en-IN', {minimumFractionDigits:2});
      document.getElementById('d_units').innerText = totU.toFixed(2);
      document.getElementById('d_cur_month_units').innerText = curMonthU.toFixed(2);
      document.getElementById('d_billed_gross').innerText = '₹' + totGrossBilled.toLocaleString('en-IN', {minimumFractionDigits:2});
      document.getElementById('d_billed_tds').innerText = '₹' + totTdsCut.toLocaleString('en-IN', {minimumFractionDigits:2});
      document.getElementById('d_billed_net').innerText = '₹' + totNetBilled.toLocaleString('en-IN', {minimumFractionDigits:2});
      document.getElementById('d_received').innerText = '₹' + totRec.toLocaleString('en-IN', {minimumFractionDigits:2});
      document.getElementById('d_pending').innerText = '₹' + pendingDue.toLocaleString('en-IN', {minimumFractionDigits:2});

      var mTable = document.getElementById('dash_monthly_units_rows');
      if (mTable) {
        mTable.innerHTML = '';
        var sortedMonths = Object.keys(monthlySummaryMap).sort().reverse();

        for (var idx = 0; idx < sortedMonths.length; idx++) {
          var monthStr = sortedMonths[idx];
          var data = monthlySummaryMap[monthStr];
          var monthTds = data.gross - data.net;

          mTable.innerHTML += '<tr>' +
            '<td><strong>📅 ' + monthStr + (monthStr === curCalendarMonth ? ' <span style="color:#10b981; font-size:11px;">(Current)</span>' : '') + '</strong></td>' +
            '<td class="num" style="color:#f59e0b; font-weight:bold;">' + data.units.toFixed(2) + '</td>' +
            '<td class="num" style="color:#f59e0b;">₹' + data.gross.toLocaleString('en-IN', {minimumFractionDigits:2}) + '</td>' +
            '<td class="num" style="color:#cbd5e1;">₹' + monthTds.toLocaleString('en-IN', {minimumFractionDigits:2}) + '</td>' +
            '<td class="num" style="color:#10b981; font-weight:bold; font-size:13px;">₹' + data.net.toLocaleString('en-IN', {minimumFractionDigits:2}) + '</td>' +
          '</tr>';
        }
      }

      var cTable = document.getElementById('dash_companies_rows');
      if (cTable) {
        cTable.innerHTML = '';
        for (var c in companies) {
          var name = companies[c].name;
          var cGross = 0;
          var cNet = 0;

          for (var a in unitsList) {
            if (unitsList[a].comp === name && (!dMonth || (unitsList[a].date && unitsList[a].date.indexOf(dMonth) === 0))) {
              var ug = unitsList[a].gross ? Number(unitsList[a].gross) : (Number(unitsList[a].units || 0) * (Number(unitsList[a].rate) || 60));
              cGross += ug;
              cNet += Number(unitsList[a].net || 0);
            }
          }
          for (var b in fixedList) {
            if (fixedList[b].comp === name && (!dMonth || (fixedList[b].date && fixedList[b].date.indexOf(dMonth) === 0))) {
              cGross += Number(fixedList[b].gross || 0);
              cNet += Number(fixedList[b].net || 0);
            }
          }

          var cTds = cGross - cNet;

          var cRec = 0;
          for (var rKey in clientReceipts) {
            if (clientReceipts[rKey].comp === name && (!dMonth || (clientReceipts[rKey].date && clientReceipts[rKey].date.indexOf(dMonth) === 0))) {
              cRec += Number(clientReceipts[rKey].amt || 0);
            }
          }

          var cDue = cNet - cRec;

          cTable.innerHTML += '<tr>' +
            '<td><strong>' + name + '</strong></td>' +
            '<td>' + companies[c].type + '</td>' +
            '<td class="num" style="color:#f59e0b;">₹' + cGross.toFixed(2) + '</td>' +
            '<td class="num" style="color:#cbd5e1;">₹' + cTds.toFixed(2) + '</td>' +
            '<td class="num" style="color:#38bdf8; font-weight:bold;">₹' + cNet.toFixed(2) + '</td>' +
            '<td class="num" style="color:#10b981;">₹' + cRec.toFixed(2) + '</td>' +
            '<td class="num" style="color:#ef4444; font-weight:bold;">₹' + cDue.toFixed(2) + '</td>' +
          '</tr>';
        }
      }
    }

    // Default Init
    var savedLang = localStorage.getItem('adrock_lang') || 'en';
    changeLanguage(savedLang);
    setTodayDate();
  </script>
