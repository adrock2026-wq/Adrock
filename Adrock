    function refreshInvoiceTemplate() {
      var docType = document.getElementById('gen_doc_type').value;
      var invNo = document.getElementById('gen_inv_no').value || 'ADR/2026/001';
      var invDate = document.getElementById('gen_inv_date').value || new Date().toISOString().split('T')[0];
      var clientComp = document.getElementById('gen_client_comp').value || 'Ernad Machine Materials';
      var clientGst = document.getElementById('gen_client_gst').value.trim() || '-';
      var clientAddr = document.getElementById('gen_client_addr').value.trim() || 'Crusher Plant Location, Kerala';
      var bankTerms = document.getElementById('gen_bank_terms').value || 'Bank Transfer within 15 days';
      var gstRate = parseFloat(document.getElementById('gen_gst_rate').value) || 0;
      var tdsApplyPct = parseFloat(document.getElementById('gen_tds_apply').value) || 0;

      document.getElementById('p_doc_type').innerText = docType;
      document.getElementById('p_inv_no').innerText = invNo;
      document.getElementById('p_inv_date').innerText = invDate;
      document.getElementById('p_client_name').innerText = clientComp;
      document.getElementById('p_client_addr').innerText = clientAddr;
      document.getElementById('p_client_gst').innerText = clientGst;
      document.getElementById('p_bank_details').innerText = bankTerms;

      var rows = document.querySelectorAll('.item-row');
      var tbody = document.getElementById('p_items_tbody');
      tbody.innerHTML = '';

      var subtotal = 0;
      rows.forEach(function(r, idx) {
        var desc = r.querySelector('.it-desc').value || 'Service Item';
        var hsn = r.querySelector('.it-hsn').value || '-';
        var qty = parseFloat(r.querySelector('.it-qty').value) || 0;
        var rate = parseFloat(r.querySelector('.it-rate').value) || 0;
        var lineAmt = qty * rate;
        subtotal += lineAmt;

        tbody.innerHTML += `
          <tr>
            <td>${idx + 1}</td>
            <td><strong>${desc}</strong></td>
            <td>${hsn}</td>
            <td class="num">${qty}</td>
            <td class="num">₹${rate.toFixed(2)}</td>
            <td class="num"><strong>₹${lineAmt.toFixed(2)}</strong></td>
          </tr>
        `;
      });

      var gstAmount = subtotal * (gstRate / 100);
      var tdsAmount = subtotal * (tdsApplyPct / 100);
      var finalPayable = (subtotal + gstAmount) - tdsAmount;

      document.getElementById('p_subtotal').innerText = '₹' + subtotal.toLocaleString('en-IN', {minimumFractionDigits:2});
      document.getElementById('p_gst_pct').innerText = gstRate;
      document.getElementById('p_gst_amt').innerText = '+₹' + gstAmount.toLocaleString('en-IN', {minimumFractionDigits:2});
      
      var tdsRow = document.getElementById('p_tds_row');
      if (tdsApplyPct > 0) {
        tdsRow.style.display = 'table-row';
        document.getElementById('p_tds_pct').innerText = tdsApplyPct;
        document.getElementById('p_tds_amt').innerText = '-₹' + tdsAmount.toLocaleString('en-IN', {minimumFractionDigits:2});
      } else {
        tdsRow.style.display = 'none';
      }

      var gstRow = document.getElementById('p_gst_row');
      if (gstRate > 0) {
        gstRow.style.display = 'table-row';
      } else {
        gstRow.style.display = 'none';
      }

      document.getElementById('p_final_total').innerText = '₹' + finalPayable.toLocaleString('en-IN', {minimumFractionDigits:2});
    }

    // 5. DAILY ATTENDANCE SHEET
    function loadDailyAttendanceSheet() {
      var container = document.getElementById('daily_sheet_container');
      if (!container) return;
      container.innerHTML = '';

      var selDate = document.getElementById('daily_att_date').value;
      if (!selDate) return;

      var companyGroups = {};
      for (var ck in companies) {
        var cN = companies[ck].name;
        if (currentUserRole === 'client' && currentUserComp && cN !== currentUserComp) continue;
        companyGroups[cN] = [];
      }

      for (var sk in staffDirectory) {
        var staff = staffDirectory[sk];
        var cName = staff.comp || 'General';
        if (currentUserRole === 'client' && currentUserComp && cName !== currentUserComp) continue;
        if (!companyGroups[cName]) companyGroups[cName] = [];
        companyGroups[cName].push(staff);
      }

      var existingAtt = {};
      for (var ak in attendanceList) {
        var att = attendanceList[ak];
        if (att.date === selDate) {
          existingAtt[att.name] = att;
        }
      }

      for (var cName in companyGroups) {
        var staffListForComp = companyGroups[cName];
        if (staffListForComp.length === 0) continue;

        var html = '<div class="comp-section-header"><span>🏢 ' + cName + '</span><span>' + staffListForComp.length + ' Staff</span></div>';
        html += '<div class="table-wrap"><table>';
        html += '<thead><tr><th style="width:40px;">#</th><th>Staff Name</th><th>Role</th><th style="width:140px;">Status</th><th style="width:90px;" class="num">OT (Hrs)</th><th>Work Remarks</th></tr></thead>';
        html += '<tbody>';

        for (var i = 0; i < staffListForComp.length; i++) {
          var st = staffListForComp[i];
          var num = i + 1;
          var rec = existingAtt[st.name] || {};
          var curStatus = rec.status || 'Present';
          var curOt = rec.ot || 0;
          var curNotes = rec.notes || '';

          html += '<tr data-comp="' + cName + '" data-name="' + st.name + '" data-role="' + st.role + '">';
          html += '<td><strong>' + num + '</strong></td>';
          html += '<td><strong>' + st.name + '</strong></td>';
          html += '<td>' + st.role + '</td>';
          html += '<td><select class="sheet-status" style="padding:6px; background:#0b1329; color:#fff; border:1px solid #334155; border-radius:4px; width:100%;">';
          html += '<option value="Present"' + (curStatus === 'Present' ? ' selected':'') + '>Present</option>';
          html += '<option value="Half Day"' + (curStatus === 'Half Day' ? ' selected':'') + '>Half Day</option>';
          html += '<option value="Absent"' + (curStatus === 'Absent' ? ' selected':'') + '>Absent</option>';
          html += '</select></td>';
          html += '<td><input type="number" step="0.5" class="sheet-ot" value="' + curOt + '" style="padding:6px; background:#0b1329; color:#fff; border:1px solid #334155; border-radius:4px; width:100%; text-align:right;"></td>';
          html += '<td><input type="text" class="sheet-notes" value="' + curNotes + '" placeholder="Task details" style="padding:6px; background:#0b1329; color:#fff; border:1px solid #334155; border-radius:4px; width:100%;"></td>';
          html += '</tr>';
        }

        html += '</tbody></table></div>';
        container.innerHTML += html;
      }
    }

    function saveDailyAttendanceSheet() {
      var selDate = document.getElementById('daily_att_date').value;
      if (!selDate) { alert('Please select a date first'); return; }

      var rows = document.querySelectorAll('#daily_sheet_container tr[data-name]');
      if (rows.length === 0) { alert('No staff members registered for this view'); return; }

      for (var ak in attendanceList) {
        if (attendanceList[ak].date === selDate) {
          if (currentUserRole === 'admin' || attendanceList[ak].comp === currentUserComp) {
            db.ref('attendance/' + ak).remove();
          }
        }
      }

      rows.forEach(function(r) {
        var comp = r.getAttribute('data-comp');
        var name = r.getAttribute('data-name');
        var role = r.getAttribute('data-role');
        var status = r.querySelector('.sheet-status').value;
        var ot = parseFloat(r.querySelector('.sheet-ot').value) || 0;
        var notes = r.querySelector('.sheet-notes').value || '-';

        db.ref('attendance').push({
          date: selDate,
          comp: comp,
          name: name,
          role: role,
          status: status,
          ot: ot,
          notes: notes
        });
      });

      alert('Daily Attendance for ' + selDate + ' Saved!');
    }

