    function pullStaffMonthData() {
      var m = document.getElementById('s_month').value;
      var name = document.getElementById('s_staff_select').value;
      if (!name) return;

      var staffObj = null;
      for (var k in staffDirectory) {
        if (staffDirectory[k].name === name) { staffObj = staffDirectory[k]; break; }
      }

      if (staffObj) {
        document.getElementById('s_type').value = staffObj.type;
        document.getElementById('s_rate').value = staffObj.rate;
        if (staffObj.comp) document.getElementById('s_comp').value = staffObj.comp;
      }

      var totalAdv = 0;
      for (var aKey in advanceList) {
        var adv = advanceList[aKey];
        if (adv.name === name && (!m || (adv.date && adv.date.indexOf(m) === 0))) {
          totalAdv += Number(adv.amt);
        }
      }
      document.getElementById('s_tot_adv').value = totalAdv;

      var daysCount = 0;
      var otHours = 0;
      for (var attKey in attendanceList) {
        var att = attendanceList[attKey];
        if (att.name === name && (!m || (att.date && att.date.indexOf(m) === 0))) {
          if (att.status === 'Present') daysCount += 1;
          else if (att.status === 'Half Day') daysCount += 0.5;
          otHours += Number(att.ot || 0);
        }
      }
      if (daysCount > 0) document.getElementById('s_days').value = daysCount;
      document.getElementById('s_ot_hours').value = otHours;

      var otRate = (staffObj && staffObj.otRate) ? Number(staffObj.otRate) : 0;
      document.getElementById('s_ot_pay').value = (otHours * otRate).toFixed(2);
      calcSalary();
    }

    function calcSalary() {
      var type = document.getElementById('s_type').value;
      var rate = parseFloat(document.getElementById('s_rate').value) || 0;
      var days = parseFloat(document.getElementById('s_days').value) || 0;
      var otPay = parseFloat(document.getElementById('s_ot_pay').value) || 0;
      var adv = parseFloat(document.getElementById('s_tot_adv').value) || 0;

      var gross = (type === 'Fixed') ? ((rate / 30) * days) : (rate * days);
      var net = (gross + otPay) - adv;
      document.getElementById('s_net_pay').value = '₹' + net.toFixed(2);
    }

